# Example configuration for the GroceryMate backend
# ------------------------------------------------
# This file is safe to publish because it contains ONLY placeholders.
# In your real .env file (not committed to GitHub), you fill in actual values.

# --------------------------------------
# JWT authentication
# --------------------------------------
# In production, this should be a long random secret key.
JWT_SECRET_KEY=changeme_jwt_secret

# --------------------------------------
# Flask environment
# --------------------------------------
# Use "development" locally. On AWS EC2, you normally use "production".
FLASK_ENV=development

# --------------------------------------
# PostgreSQL Database (AWS RDS or Local)
# --------------------------------------
POSTGRES_USER=grocery_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=grocerymate_db

# If running locally:
POSTGRES_HOST=localhost

# If running on AWS RDS, replace this in your real .env:
# POSTGRES_HOST=your-rds-endpoint.amazonaws.com

# Unified database URI format
POSTGRES_URI=postgresql://grocery_user:your_password_here@your_host_here:5432/grocerymate_db

# --------------------------------------
# Optional: Maintenance Mode
# --------------------------------------
# When set to "true", the API returns a maintenance message for all users.
MAINTENANCE_MODE=false

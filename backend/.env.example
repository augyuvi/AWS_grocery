# Example configuration for my GroceryMate backend

# In my real .env I set this to a long random string for JWT authentication
JWT_SECRET_KEY=changeme_jwt_secret

# Optional – I use development while I am testing locally
FLASK_ENV=development

# PostgreSQL on AWS RDS
# In my real .env I use my actual RDS password and endpoint here
POSTGRES_USER=grocery_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=grocerymate_db
POSTGRES_HOST=your-rds-endpoint-here
POSTGRES_URI=postgresql://grocery_user:your_password_here@your-rds-endpoint-here:5432/grocerymate_db
